  "components": {
    "schemas": {
      "HorizontalBarChartPayload": {
        "title": "HorizontalBarChartPayload",
        "anyOf": [
          {
            "$ref": "#/components/schemas/HorizontalBarChartDefinition"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HorizontalBarChartDefinition"
            }
          }
        ]
      },
      "HorizontalBarChartDefinition": {
        "title": "HorizontalBarChartDefinition",
        "allOf": [
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {},
                "title": "data"
              }
            },
            "required": [
              "data"
            ]
          },
          {
            "type": "object",
            "properties": {
              "legendLabels": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "title": "legendLabels"
              },
              "barHeight": {
                "type": "number",
                "title": "barHeight"
              },
              "labelFormat": {
                "description": "`sprintf` format to use for labels on y-axis of the chart, where `%1` is the key and `%2` is the label",
                "example": "%2$s",
                "ref": "https://www.npmjs.com/package/sprintf-js#format-specification",
                "type": "string",
                "title": "labelFormat"
              },
              "linkFormat": {
                "description": "`sprintf` format to use for rendering y-axis labels as links on the chart, where `%1` is the key",
                "example": "/school/%1$s",
                "ref": "https://www.npmjs.com/package/sprintf-js#format-specification",
                "type": "string",
                "title": "linkFormat"
              },
              "missingDataLabel": {
                "type": "string",
                "title": "missingDataLabel"
              },
              "missingDataLabelWidth": {
                "type": "number",
                "title": "missingDataLabelWidth"
              },
              "paddingInner": {
                "description": "Sets the inner padding to the specified value which must be in the range [0, 1].\nThe inner padding determines the ratio of the range that is reserved for blank space between bands.",
                "default": 0.2,
                "type": "number",
                "title": "paddingInner"
              },
              "paddingOuter": {
                "description": "Sets the outer padding to the specified value which must be in the range [0, 1].\nThe outer padding determines the ratio of the range that is reserved for blank space before the first band and after the last band.",
                "default": 0.1,
                "type": "number",
                "title": "paddingOuter"
              },
              "valueType": {
                "$ref": "#/components/schemas/ValueType",
                "description": "Describes how values on the chart should be interpreted and formatted.\nThis determines both the visual representation (e.g. percentage or currency)\nand any necessary normalisation (e.g. dividing percent values by 100).\nMust be one of the predefined `ValueType` options.",
                "title": "valueType"
              },
              "xAxisLabel": {
                "type": "string",
                "title": "xAxisLabel"
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "sort": {
                "enum": [
                  "asc",
                  "desc"
                ],
                "type": "string",
                "title": "sort"
              },
              "id": {
                "type": "string",
                "title": "id"
              },
              "width": {
                "type": "number",
                "title": "width"
              },
              "domainMax": {
                "description": "Maximum value for the domain of the linear scaled chart.\nDefaults to the maximum value from the provided data set.\nValues less than the maximum value from the provided data set are not allowed and instead will be treated as that maximum value.",
                "type": "number",
                "title": "domainMax"
              },
              "domainMin": {
                "description": "Minimum value for the domain of the linear scaled chart.\nNegative values are not allowed at this time and instead will be treated as `0`.\nValues more than the minimum value from the provided data set are not allowed and instead will be treated as that minimum value.",
                "default": 0,
                "type": "number",
                "title": "domainMin"
              },
              "highlightKey": {
                "type": "string",
                "title": "highlightKey"
              }
            }
          },
          {
            "$ref": "#/components/schemas/ChartDefinition"
          }
        ]
      },
      "ValueType": {
        "title": "ValueType",
        "enum": [
          "currency",
          "numeric",
          "percent"
        ],
        "type": "string"
      },
      "ChartDefinition": {
        "title": "ChartDefinition",
        "type": "object",
        "properties": {
          "keyField": {
            "type": "string",
            "title": "keyField"
          },
          "valueField": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "title": "valueField"
          }
        },
        "required": [
          "keyField",
          "valueField"
        ]
      },
      "ChartBuilderResult": {
        "title": "ChartBuilderResult",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "id"
          },
          "html": {
            "type": "string",
            "title": "html"
          }
        },
        "required": [
          "html",
          "id"
        ]
      },
      "VerticalBarChartPayload": {
        "title": "VerticalBarChartPayload",
        "anyOf": [
          {
            "$ref": "#/components/schemas/VerticalBarChartDefinition"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VerticalBarChartDefinition"
            }
