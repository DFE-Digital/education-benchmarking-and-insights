@model Web.App.ViewModels.LocalAuthorityRisksViewModel
@{
    ViewData[ViewDataKeys.Title] = PageTitles.LocalAuthorityRisksOverview;
}

@await Component.InvokeAsync("EstablishmentHeading", new { title = ViewData[ViewDataKeys.Title], name = Model.Name, id = Model.Code, kind = OrganisationTypes.LocalAuthority })

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <div class="govuk-inset-text">
            This data covers maintained schools for the financial year from April @(Model.CfrYear-1) to March @Model.CfrYear. Federation schools are not included.
        </div>

        @await Html.PartialAsync("_HowToUnderstandRiskScores")
    </div>
</div>

@await Html.PartialAsync("_PageActions")

@await Html.PartialAsync("_SortablePagedTable")
