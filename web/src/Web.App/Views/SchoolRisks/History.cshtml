@using Web.App.ViewModels.Enhancements
@model Web.App.ViewModels.SchoolRisksHistoryViewModel

@{
    ViewData[ViewDataKeys.Title] = PageTitles.SchoolRisksHistory;
}

@section Backlink {
    <a class="govuk-back-link" href="@Url.Action("Index", "SchoolRisks", new { code = Model.LaCode, Model.Urn })">Back</a>
}

@await Component.InvokeAsync("EstablishmentHeading", new
{
    title = PageTitles.SchoolRisksHistory,
    name = Model.Name,
    id = Model.Urn,
    kind = OrganisationTypes.School
})

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        @await Html.PartialAsync("_HistoryIntroduction")
        @await Html.PartialAsync("_HistoryPageActions")
        <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">
        @await Html.PartialAsync("_DisplayHistorySections")
    </div>
</div>

@section scripts
{
    @await Html.PartialAsync("Enhancements/_PageActions", new PageActionsViewModel
    {
        All = true,
        ElementId = "page-actions-button",
        SaveClassName = "costs-chart-container",
        SaveFileName = $"{Model.Name}-trend-in-risk-scores-charts.zip",
        SaveTitleAttr = "data-title",
        StartImmediately = true
    })
}
