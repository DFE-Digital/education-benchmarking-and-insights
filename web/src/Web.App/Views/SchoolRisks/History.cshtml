@using Web.App.Domain.Charts
@model Web.App.ViewModels.SchoolRisksHistoryViewModel

@{
    ViewData[ViewDataKeys.Title] = PageTitles.SchoolRisksHistory;
}

@section Backlink {
    <a class="govuk-back-link" href="@Url.Action("Index", "SchoolRisks", new { code = Model.LaCode, Model.Urn })">Back</a>
}

@await Component.InvokeAsync("EstablishmentHeading", new
{
    title = PageTitles.SchoolRisksHistory,
    name = Model.Name,
    id = Model.Urn,
    kind = OrganisationTypes.School
})

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        @await Html.PartialAsync("_HistoryIntroduction")
        @await Html.PartialAsync("_HistoryPageActions")
        <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">
        @if (Model.ViewAs == Views.ViewAsOptions.Chart)
        {
            @*TODO: replace with charts partial - AB#328172*@
            <p class="govuk-body">
                Charts placeholder
            </p>
        }
        else
        {
            @*TODO: replace with tables partial - AB#328169*@
            <p class="govuk-body">
                Tables placeholder
            </p>
        }
    </div>
</div>
