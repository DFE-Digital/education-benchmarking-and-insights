@using Web.App.Domain.Charts
@using Web.App.ViewModels

@model Web.App.ViewModels.SchoolRisksHistoryViewModel

<div class="govuk-!-margin-top-6 options-form-and-page-actions">
    @using (Html.BeginForm(FormMethod.Post, true, new
            {
                @class = "options-form",
                novalidate = "novalidate",
                role = "search"
            }))
    {
        <div class="options-form__view-as">
            <fieldset class="govuk-fieldset">
                <legend class="govuk-label govuk-!-font-weight-bold">
                    View as
                </legend>
                <div class="govuk-radios govuk-radios--small" data-module="govuk-radios"
                     id="@nameof(SchoolRisksHistoryViewModel.ViewAs)">
                    @foreach (var view in Views.All)
                    {
                        <div class="govuk-radios__item">
                            <input class="govuk-radios__input"
                                   id="view-@view"
                                   name="@nameof(SchoolRisksHistoryViewModel.ViewAs)" type="radio"
                                   value="@((int)view)"
                                   @(Model.ViewAs == view ? "checked" : "")>
                            <label class="govuk-label govuk-radios__label"
                                   for="view-@view">
                                @view.GetDescription()
                            </label>
                        </div>
                    }
                </div>
            </fieldset>
        </div>

        <div class="options-form__apply">
            <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">
                Apply
            </button>
        </div>
    }

    <div class="page-actions-stack-end">
        @if (Model.ViewAs == Views.ViewAsOptions.Chart)
        {
            <div id="page-actions-button" class="govuk-!-margin-bottom-0"></div>
        }
        <a href="@Url.Action("HistoryDownload", "SchoolRisks", new { code = Model.LaCode, urn = Model.Urn })"
           role="button"
           class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0"
           data-module="govuk-button">Download page data</a>
    </div>
</div>
