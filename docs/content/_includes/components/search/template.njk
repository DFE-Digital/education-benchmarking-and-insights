<div class="app-search app-pagefind-search govuk-!-display-none-print">
  <a class="app-search__link" href="/search/">Search</a>
  <button
    type="button"
    class="app-pagefind-search__button"
    id="header-search-button"
    aria-haspopup="dialog"
    aria-controls="pagefind-search-dialog"
    aria-label="{{ params.label | default('Search documentation') }} (shortcut: /)"
  >
    <span class="app-pagefind-search__icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" focusable="false">
        <path d="M12.755 11.255h-.79l-.28-.27a6.47 6.47 0 0 0 1.57-4.23 6.5 6.5 0 1 0-6.5 6.5c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99 1.49-1.49-4.99-5Zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9Z" fill="currentColor"/>
      </svg>
    </span>
    <span class="app-pagefind-search__text">{{ params.label | default("Search documentation") }}</span>
    <kbd class="app-pagefind-search__shortcut" aria-hidden="true">/</kbd>
  </button>
</div>
